[build]
  command = "npm run build"
  publish = "dist"

# Version canonique du site : non-www.
# www.lokaz.net -> lokaz.net en 301 (permanent).
[[redirects]]
  from = "https://www.lokaz.net/*"
  to = "https://lokaz.net/:splat"
  status = 301
  force = true

# Fallback SPA : toute route inconnue sert index.html.
# Indispensable dès l'ajout d'un routeur ; sans ça, /contact renvoie une 404.
[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200

[[headers]]
  for = "/*"
  [headers.values]
    X-Content-Type-Options = "nosniff"
    X-Frame-Options = "SAMEORIGIN"
    Referrer-Policy = "strict-origin-when-cross-origin"

# Les assets Vite sont hashés : cache immuable et long.
[[headers]]
  for = "/assets/*"
  [headers.values]
    Cache-Control = "public, max-age=31536000, immutable"

[[headers]]
  for = "/sitemap.xml"
  [headers.values]
    Content-Type = "application/xml; charset=utf-8"
